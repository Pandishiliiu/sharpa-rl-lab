    def change_tactile_config(self, on_board=None):
        """Prepare a tactile config compatible with Sharpa SDK v5.0.11."""

        if on_board is None:
            on_board = True

        try:
            source_path = Path(
                "/opt/sharpa-wave-sdk/config/tactile.json"
            )

            side = "left" if self.cfg.hand_side == 0 else "right"

            output_path = (
                Path.home()
                / ".config"
                / "sharpa-rl-lab"
                / f"tactile_{side}.json"
            )

            prepared_path = prepare_tactile_config(
                source_path=source_path,
                output_path=output_path,
                hand_side=self.cfg.hand_side,
                on_board=on_board,
            )

            self.tactile_config_path = str(prepared_path)

            print(
                f"[TactileConfig] Config prepared: "
                f"{self.tactile_config_path}"
            )

            return True

        except (OSError, ValueError, TypeError) as e:
            print(f"[TactileConfig] Configuration error: {e}")
            return False
    
    

    '''
    它们共同承担了从动作输入到控制指令的处理
    def _pre_physics_step(self, actions)和def _apply_action(self)
    '''


    def _pre_physics_step(self, actions: torch.Tensor) -> None:
        actions = saturate(actions, torch.tensor(-self.cfg.clip_actions), torch.tensor(self.cfg.clip_actions))
        self.actions = actions.clone()
        targets = self.prev_targets + self.cfg.action_scale * self.actions      #策略输出的不是绝对角度，而是在当前目标基础上增加一个控制增量
        self.cur_targets = saturate(targets, self.hand_dof_lower_limits, self.hand_dof_upper_limits)        #再次限制目标关节角度

    def _apply_action(self) -> None:        #把目标角度发送给机器人
        self._refresh_lab()
        command = dof_isaaclab2sharpa(self.cur_targets.squeeze()).cpu().numpy()         #Isaac Lab 和 Sharpa SDK 的22个关节可能采用不同的排列顺序，转换
        self.hand.set_joint_position(command)       #将目标位置交给 SDK
        self.prev_targets = self.cur_targets.clone()        #保存本次目标

    def _get_observations(self) -> dict:
        self._refresh_lab()
        obs = self.compute_observations()
        observations = {
            "policy": obs,
            "proprio_hist": self.proprio_hist_buf,
        }
        return observations

    def step(self, action):
                # Reject policy execution if tactile observations are unavailable.

        # 1. 获取当前控制状态
        if self.cfg.keyboard_listen:
            deploy_state = self.deploy_state_flag.get()
        else:
            deploy_state = 3

        # 2. Standby 不需要有效触觉数据
        if self.cfg.enable_tactile and deploy_state != 4:
            status = self.get_tactile_status()

            if not status["ready"]:
                raise RuntimeError(
                    "Tactile data unavailable: "
                    f"missing={status['missing']}, "
                    f"stale={status['stale']}"
                )
        if self.cfg.keyboard_listen:
            # tactile
            if self.calib_tactile_flag.get() == 1:
                self.calib_tactile()
                self.calib_tactile_flag.set(0)
            # deploy state
            if deploy_state == 0:
                self.hand.set_joint_position([0] * 22)
            elif deploy_state == 1:
                freeze_actions = self.hand.get_states().angles
                self.hand.set_joint_position(freeze_actions)
            elif deploy_state == 2:
                self._reset_idx([0])
            # elif deploy_state == 3:
            #     action = action.to(self.device)
            #     self._pre_physics_step(action)
            #     self._apply_action()
            # else:
            #     freeze_actions = self.hand.get_states().angles
            #     self.hand.set_joint_position(freeze_actions)
            elif deploy_state == 3:
                action = action.to(self.device)
                self._pre_physics_step(action)
                self._apply_action()

            elif deploy_state == 4:
                # Standby: do not issue joint position commands.
                pass

            else:
                freeze_actions = self.hand.get_states().angles
                self.hand.set_joint_position(freeze_actions)
        else:
            action = action.to(self.device)
            self._pre_physics_step(action)
            self._apply_action()
        loop_dt = time.perf_counter() - self._last_step_wall
        if loop_dt < self.target_dt:
            time.sleep(self.target_dt - loop_dt)
        self._last_step_wall = time.perf_counter()
        self.episode_length_buf += 1

        # Standby: keep the last valid observation.
        # No new tactile observation is generated.
        if deploy_state != 4:
            self.obs_buf = self._get_observations()

            return self.obs_buf, None, None, None, None
    
        def _check_reset_gate(self, stage):
            """Check whether reset is still authorized and tactile data is valid."""

            # 1. 检查用户是否仍然允许执行 Reset
            if self.cfg.keyboard_listen:
                state = self.deploy_state_flag.get()

                if state != 2:
                    raise RuntimeError(
                        f"[Reset:{stage}] Cancelled: control state={state}"
                    )

            # 2. 检查触觉数据是否有效
            if self.cfg.enable_tactile:
                status = self.get_tactile_status()

                if not status["ready"]:

                    # 触觉故障：退出 Reset，进入软件待机状态
                    if self.cfg.keyboard_listen:
                        self.deploy_state_flag.set(4)

                    raise RuntimeError(
                        f"[Reset:{stage}] Tactile unavailable: "
                        f"missing={status['missing']}, "
                        f"stale={status['stale']}"
                    )

    def _reset_idx(self, env_ids: Sequence[int] | None):
        # Standby: do not execute reset motions before authorization.
        if self.cfg.keyboard_listen:
            if self.deploy_state_flag.get() == 4:
                return

        # if self.cfg.warm_up:
        #     error = self.hand.set_speed_coeff(0.3)
        #     error = self.hand.set_current_coeff(self.cfg.current_coef)
        #     self.hand.set_joint_position([0] * 22)
        #     time.sleep(3)
        self._check_reset_gate("start")

        if self.cfg.warm_up:
            error = self.hand.set_speed_coeff(0.3)
            error = self.hand.set_current_coeff(self.cfg.current_coef)

            self._check_reset_gate("before_home")
            self.hand.set_joint_position([0] * 22)

            # 等待3秒，但每50ms检查一次
            deadline = time.monotonic() + 3.0

            while time.monotonic() < deadline:
                self._check_reset_gate("home_wait")

                remaining = deadline - time.monotonic()

                if remaining > 0:
                    time.sleep(min(0.05, remaining))

        # if self.cfg.keyboard_listen:
        #     if self.deploy_state_flag.get() == 0: return
        #     self.deploy_state_flag.set(3)

        if env_ids is None:
            env_ids = self.hand._ALL_INDICES
        self.episode_length_buf[env_ids] = 0

        error = self.hand.set_speed_coeff(self.cfg.speed_coef)
        error = self.hand.set_current_coeff(self.cfg.current_coef)

        # reset hand
        if self.cfg.warm_up:
            # replay traj until grasp
            traj = np.load('cache/deploy_init_traj.npy')
            self._check_reset_gate("before_trajectory")

            tactile_force, _ = self.get_tactile_info()
            j = 0

            self._check_reset_gate("trajectory_start")
            self.hand.set_joint_position(traj[j])
            while torch.max(tactile_force) < 1 and j + 3 < len(traj):

                self._check_reset_gate("trajectory_step")

                j += 1
                self.hand.set_joint_position(traj[j])

                time.sleep(0.03)

                self._check_reset_gate("trajectory_read")
                tactile_force, _ = self.get_tactile_info()
                
            print(f"pick num {j} traj in {len(traj)}")
            self.prev_targets[env_ids] = dof_sharpa2isaaclab(torch.tensor(traj[j+2], dtype=torch.float32, device=self.device))
            self.cur_targets[env_ids] = dof_sharpa2isaaclab(torch.tensor(traj[j+2], dtype=torch.float32, device=self.device))

        self._refresh_lab()

        # reset data buffers
        self.last_contacts[env_ids] = 0
        self.proprio_hist_buf[env_ids] = 0
        self.at_reset_buf[env_ids] = 1

        # Reset completed successfully.
        self._check_reset_gate("finish")

        if self.cfg.keyboard_listen:
            self.deploy_state_flag.set(3)

    def _refresh_lab(self):         #SDK 获取当前关节角度，转换为 Isaac Lab 的顺序，保存到 hand_dof_pos， 转换成神经网络需要的张量
        self.hand_dof_pos = dof_sharpa2isaaclab(torch.tensor(self.hand.get_states().angles)).reshape(1, -1).to(self.device)

    def compute_observations(self):
        # contact               将原始数据组织成策略观测向量
        sensed_contacts, contact_pos = self.get_tactile_info()
        # deal with normal observation, do sliding window
        prev_obs_buf = self.obs_buf_lag_history[:, 1:].clone()
        cur_obs_buf = unscale(self.hand_dof_pos, self.hand_dof_lower_limits, self.hand_dof_upper_limits).clone().unsqueeze(1)
        cur_tar_buf = self.cur_targets.unsqueeze(1)
        cur_obs_buf = torch.cat([cur_obs_buf, cur_tar_buf], dim=-1)
        cur_obs_buf = torch.cat([cur_obs_buf, sensed_contacts.unsqueeze(1), contact_pos.unsqueeze(1)], dim=-1)
        self.obs_buf_lag_history[:] = torch.cat([prev_obs_buf, cur_obs_buf], dim=1)

        # refill the initialized buffers
        at_reset_env_ids = self.at_reset_buf.nonzero(as_tuple=False).squeeze(-1)
        self.obs_buf_lag_history[at_reset_env_ids, :, 0:22] = unscale(
            self.hand_dof_pos[at_reset_env_ids], 
            self.hand_dof_lower_limits[at_reset_env_ids],
            self.hand_dof_upper_limits[at_reset_env_ids],
        ).clone().unsqueeze(1)
        self.obs_buf_lag_history[at_reset_env_ids, :, 22:44] = self.hand_dof_pos[at_reset_env_ids].unsqueeze(1)
        self.obs_buf_lag_history[at_reset_env_ids, :, 44:49] = sensed_contacts[at_reset_env_ids].unsqueeze(1)
        self.obs_buf_lag_history[at_reset_env_ids, :, 49:64] = contact_pos[at_reset_env_ids].unsqueeze(1)
        self.at_reset_buf[at_reset_env_ids] = 0
        obs_buf = (self.obs_buf_lag_history[:, -3:].reshape(self.num_envs, -1)).clone()         #64=22+22+5+15维取最近3帧变成192维

        self.proprio_hist_buf[:] = self.obs_buf_lag_history[:, -self.cfg.prop_hist_len:].clone()

        return obs_buf
    
    def calib_tactile(self):
        # calibrate tactile
        if not self.hand.calib_tactile(): 
            print(f'Tactile calibration failed')
            return False
        else:
            print(f'Tactile calibration successful')
            return True
    
    def get_tactile_status(self, max_age=0.5):
        """Check whether required tactile channels are fresh."""

        if not self.cfg.enable_tactile:
            return {
                "ready": True,
                "missing": [],
                "stale": [],
            }

        return check_tactile_freshness(
            last_seen=self.tactile_last_seen.copy(),
            hand_side=self.cfg.hand_side,
            disabled_fingers=self.cfg.disable_tactile_ids,
            max_age=max_age,
        )

    def get_tactile_info(self):
        # 1. 检查触觉数据是否有效
        if self.cfg.enable_tactile and deploy_state != 4:
            status = self.get_tactile_status()

            if not status["ready"]:
                raise RuntimeError(
                    "Tactile observation unavailable: "
                    f"missing={status['missing']}, "
                    f"stale={status['stale']}"
                )
        force = torch.zeros(5, dtype=torch.float32, device=self.device)
        contact_pos = torch.zeros((5, 3), dtype=torch.float32, device=self.device)

        if not self.cfg.enable_tactile:
            return force.reshape(1, -1), contact_pos.reshape(1, -1)

        # # get tactile data
        # for ch in range(5):
        #     _, f_norm, _, contact_pos_ch = self.frames[4-ch+5*(1-self.cfg.hand_side)]           #触觉通道映射公式，就是策略索引01234-->SDK通道
        #     force[ch] = f_norm
        #     contact_pos[ch] = contact_pos_ch
        
        # get tactile data
        for finger in range(5):

            # 禁用的手指不要求触觉数据
            if finger in self.cfg.disable_tactile_ids:
                continue

            channel = 4 - finger + 5 * (1 - self.cfg.hand_side)

            _, f_norm, _, contact_pos_ch = self.frames[channel]

            # 防止时间戳与缓存状态不一致
            if f_norm is None or contact_pos_ch is None:
                raise RuntimeError(
                    f"Tactile cache incomplete: channel={channel}"
                )

            force[finger] = f_norm
            contact_pos[finger] = contact_pos_ch
        
        # check disable
        force[self.cfg.disable_tactile_ids] = 0.0
        contact_pos[self.cfg.disable_tactile_ids] = 0.0

        if not self.cfg.enable_contact_pos:
            contact_pos[:] = 0.0

        # check thresh
        force *= self.cfg.force_scale       #对力的模长进行比例缩放，配置文件里面写的是/1.5
        force[force < self.cfg.contact_threshold] = 0.0         #设置阈值，如果规范力信息小于0.2，就直接置零
        if self.cfg.binary_contact:
            force = torch.where(force > self.cfg.contact_threshold, 1.0, 0.0)
        contact_pos[force < self.cfg.contact_threshold] = 0.0

        return force.reshape(1, -1), contact_pos.reshape(1, -1)

    def go_home(self):
        self.hand.set_joint_position([0] * 22)
        time.sleep(3)


@torch.jit.script
def saturate(x: torch.Tensor, lower: torch.Tensor, upper: torch.Tensor) -> torch.Tensor:
    return torch.max(torch.min(x, upper), lower)

@torch.jit.script
def unscale(x, lower, upper):
    return (2.0 * x - upper - lower) / (upper - lower)
