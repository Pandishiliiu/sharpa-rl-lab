    def tactile_callback(self, frame):
        # 1. 校验触觉帧
        result = validate_tactile_frame(
            frame,
            self.cfg.hand_side,
        )

        if result is None:
            return

        ch, force_norm = result
        content = frame["content"]

        # 2. 读取原始图像（可选）
        img = content.get("RAW")

        if img is not None and hasattr(img, "squeeze"):
            img = img.squeeze()
        else:
            img = None

        # 3. 计算有效接触力
        f_norm = torch.tensor(
            force_norm,
            dtype=torch.float32,
            device=self.device,
        )

        # 4. 初始化接触位置
        contact_pos = torch.zeros(
            (3,),
            dtype=torch.float32,
            device=self.device,
        )

        # 5. 尝试解析接触点
        points = content.get("CONTACT_POINT")

        if points is not None:
            try:
                p = torch.as_tensor(
                    points,
                    dtype=torch.float32,
                ).reshape(-1, 3)

                if p.numel() > 0 and bool(torch.isfinite(p).all()):
                    centroid = p[torch.argmax(p[:, 2])]

                    x = int(centroid[0])
                    y = int(centroid[1])

                    local_ch = ch - 5 * (1 - self.cfg.hand_side)
                    uv_map = self.tac_uv_map[local_ch]

                    if (
                        0 <= y < uv_map.shape[0]
                        and 0 <= x < uv_map.shape[1]
                    ):
                        contact_pos = torch.as_tensor(
                            uv_map[y, x][:3],
                            dtype=torch.float32,
                            device=self.device,
                        ) / 1000.0

            except (TypeError, ValueError, IndexError, RuntimeError):
                pass

        # 6. 只有校验通过的触觉帧才能更新缓存
        self.frames[ch] = (
            img,
            f_norm,
            None,
            contact_pos,
        )
        self.tactile_last_seen[ch] = time.monotonic()

